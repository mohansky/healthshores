---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | HealthShores`} description={description}>
  <main class="pt-20">
    <section class="py-16 bg-muted">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <Badge variant="primary" class="mb-4">Legal</Badge>
          <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">{title}</h1>
          <p class="text-muted-foreground">Last updated: {updated}</p>
        </div>
      </div>
    </section>

    <article class="py-12 pb-20">
      <div class="container mx-auto px-4">
        <div class="legal-content max-w-3xl mx-auto">
          <slot />
        </div>
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  .legal-content {
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .legal-content h2 {
    color: var(--foreground);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 2.5rem 0 1rem;
  }
  .legal-content h3 {
    color: var(--foreground);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.75rem 0 0.75rem;
  }
  .legal-content p {
    margin: 0 0 1rem;
  }
  .legal-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0 0 1rem;
  }
  .legal-content li {
    margin: 0.35rem 0;
  }
  .legal-content strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .legal-content a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content .callout {
    border-left: 4px solid var(--primary);
    background: var(--muted);
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    color: var(--foreground);
  }
</style>
