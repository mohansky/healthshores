---
import { getEntry } from 'astro:content';
import Badge from './starwind/badge/Badge.astro';
import { Image } from 'astro:assets';

const sectionsData = await getEntry('sections', 'homepage');
if (!sectionsData?.data.about) {
  throw new Error('About section data not found');
}
const { about } = sectionsData.data;
---

<section id="about" class="py-20 bg-muted">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Image -->
      {about.image && (
        <div class="relative">
          <div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden shadow-2xl">
            <Image
              src={about.image}
              alt={about.title}
              title={about.title}
              class="w-full h-full object-cover"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 50vw"
            />
          </div>
   
        </div>
      )}

      <!-- Content -->
      <div>
        <Badge variant="primary" class="mb-4">
          {about.badge}
        </Badge>
        <h2 class="text-4xl font-bold text-foreground mb-6">
          {about.title}
        </h2>
        {about.description.map((paragraph) => (
          <p class="text-lg text-muted-foreground mb-6">
            {paragraph}
          </p>
        ))}

        <!-- Features -->
        <div class="space-y-4 mt-8">
          {about.features.map((feature) => (
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-6 h-6 bg-primary rounded-full flex items-center justify-center mt-1">
                <svg class="w-4 h-4 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">{feature.title}</h3>
                <p class="text-muted-foreground">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
