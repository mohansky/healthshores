---
import { getEntry } from "astro:content";
import Button from "./starwind/button/Button.astro";

const globalData = await getEntry("global", "site");
if (!globalData) {
  throw new Error("Global site data not found");
}
const { navigation, site } = globalData.data;

type NavItem = {
  label: string;
  href: string;
};
---

<nav
  class="fixed w-full top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-200"
>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2">
        <img src="/src/assets/hs-logo.svg" alt="logo" class="w-20 h-20" />
        <span class="sr-only">{site.name}</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {
          navigation.map((item: NavItem) => (
            <a
              href={item.href}
              class="text-gray-700 hover:text-primary transition-colors font-medium"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <Button href="#contact" variant="primary">Get Started</Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-gray-700 hover:text-primary"
        aria-label="Toggle menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden h-screen md:hidden pb-4">
      {
        navigation.map((item: NavItem) => (
          <a
            href={item.href}
            class="block py-2 text-gray-700 hover:text-primary transition-colors font-medium"
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-4">
        <Button href="#contact" variant="primary" class="w-full"
          >Get Started</Button
        >
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  // Close menu when clicking on a link
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
    });
  });
</script>
