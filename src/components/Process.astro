---
import { getEntry } from "astro:content";
import Badge from "./starwind/badge/Badge.astro";
import Button from "./starwind/button/Button.astro";
import Card from "./starwind/card/Card.astro";

const sectionsData = await getEntry("sections", "homepage");
if (!sectionsData?.data.process) {
  throw new Error("Process section data not found");
}
const { process } = sectionsData.data;

// Dynamic icon imports
const iconComponents: Record<string, any> = {};
for (const step of process.steps) {
  if (step.icon) {
    try {
      const component = await import(`./icons/${step.icon}.astro`);
      iconComponents[step.icon] = component.default;
    } catch (error) {
      console.warn(`Icon component ${step.icon} not found`);
    }
  }
}
---

<section id="process" class="py-20 bg-gradient-to-b from-muted to-background">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <Badge variant="primary" class="mb-4">
        {process.badge}
      </Badge>
      <h2 class="text-4xl font-bold text-foreground mb-4">
        {process.title}
      </h2>
      <p class="text-lg text-muted-foreground">
        {process.description}
      </p>
    </div>

    <!-- Process Timeline -->
    <div class="max-w-4xl mx-auto">
      {
        process.steps.map((step, index) => (
          <div class="relative flex items-start mb-12">
            {/* Desktop: Timeline on the left */}
            <div class="hidden md:flex flex-col items-center mr-6">
              <div class="flex items-center justify-center w-16 h-16 bg-primary text-primary-foreground rounded-full font-bold text-xl z-10">
                {index + 1}
              </div>
              {index < process.steps.length - 1 && (
                <div class="w-1 h-full bg-primary/20 absolute top-16 left-8" />
              )}
            </div>

            {/* Card */}
            <Card class="flex-1 p-8 hover:border-primary transition-all hover:shadow-xl relative">
              {/* Mobile: Circle on top left corner */}
              <div class="md:hidden absolute -top-3 -left-3 flex items-center justify-center w-12 h-12 bg-primary text-primary-foreground rounded-full font-bold text-lg z-10">
                {index + 1}
              </div>

              <span class="flex items-center  gap-2">
                {step.icon && iconComponents[step.icon] && (
                  <div class="w-12 h-12 bg-primary/10 rounded-xl p-3 flex items-center justify-center mb-3">
                    {(() => {
                      const IconComponent = iconComponents[step.icon];
                      return IconComponent ? (
                        <IconComponent class="w-full h-full fill-primary" />
                      ) : null;
                    })()}
                  </div>
                )}
                <h3 class="text-2xl font-bold text-foreground">{step.title}</h3>
              </span>
              <p class="text-muted-foreground mb-4">{step.description}</p>
              <ol class="list-decimal list-inside space-y-1">
                {step.tags.map((tag) => (
                  <li>
                    {tag}
                  </li>
                ))}
              </ol>
            </Card>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-lg text-muted-foreground mb-6">
        {process.cta.description}
      </p>
      <Button href="#contact" size="lg" title={process.cta.text}>
        {process.cta.text}
        <svg
          class="w-5 h-5 ml-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </Button>
    </div>
  </div>
</section>
