---
import { getEntry } from 'astro:content';
import Badge from './starwind/badge/Badge.astro';
import Card from './starwind/card/Card.astro';
import CardHeader from './starwind/card/CardHeader.astro';
import CardTitle from './starwind/card/CardTitle.astro';
import CardDescription from './starwind/card/CardDescription.astro';
import CardContent from './starwind/card/CardContent.astro';

const sectionsData = await getEntry('sections', 'homepage');
if (!sectionsData?.data.services) {
  throw new Error('Services section data not found');
}
const { services } = sectionsData.data;

// Icon mapping
const iconPaths: Record<string, string> = {
  clipboard: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
  home: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
  users: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z",
  document: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  heart: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  currency: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
};
---

<section id="services" class="py-20 bg-background">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="text-center mb-12">
        <Badge variant="primary" class="mb-4">
          {services.badge}
        </Badge>
        <h2 class="text-4xl font-bold text-foreground mb-6">
          {services.title}
        </h2>
        <!-- <p class="text-lg text-muted-foreground">
          {services.introText}
        </p> -->
      </div>

      <div class="mb-8">
        <p class="text-lg text-muted-foreground">
          {services.whyChooseUs}
        </p>
      </div>

      <div class="mb-12">
        <p class="text-lg text-muted-foreground">
          {services.commitment}
        </p>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.items.map((service) => (
        <Card class="group hover:border-primary transition-all hover:shadow-xl">
          <CardHeader>
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[service.icon]}></path>
              </svg>
            </div>
            <CardTitle>{service.title}</CardTitle>
            <CardDescription>{service.description}</CardDescription>
          </CardHeader>
          <CardContent>
            <ul class="space-y-2 text-sm text-muted-foreground">
              {service.features.map((feature) => (
                <li class="flex items-center">
                  <svg class="w-4 h-4 text-primary mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
